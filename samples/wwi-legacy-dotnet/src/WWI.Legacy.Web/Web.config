<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <!-- Main OLTP database, Windows authentication from the IIS app-pool identity -->
    <add name="WideWorldImporters"
         connectionString="Data Source=WWI-SQL01\PROD;Initial Catalog=WideWorldImporters;Integrated Security=SSPI;MultipleActiveResultSets=true;Application Name=WWI.Legacy.Web"
         providerName="System.Data.SqlClient" />
    <!-- Reporting replica, SQL authentication (placeholder password used by the redaction test) -->
    <add name="WideWorldImportersReporting"
         connectionString="Server=tcp:wwi-sql02.corp.local,1433;Database=WideWorldImporters;User ID=wwi_report;Password=NotARealPassword-123;Encrypt=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
    <!-- EF6 database-first model -->
    <add name="WwiEntities"
         connectionString="metadata=res://*/Models.WwiModel.csdl|res://*/Models.WwiModel.ssdl|res://*/Models.WwiModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=WWI-SQL01\PROD;initial catalog=WideWorldImporters;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;"
         providerName="System.Data.EntityClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <authentication mode="Windows" />
  </system.web>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>
