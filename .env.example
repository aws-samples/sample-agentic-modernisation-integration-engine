# ============================================================================
# Code Transformation Engine - Environment Configuration
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit `.env` (it is git-ignored). All values below are placeholders.
# Defaults are dev-friendly: with AUTH_DISABLED=true and AGENTCORE_MODE=false
# the full docker-compose stack boots without any AWS credentials for local
# UI work (AI features that call Bedrock still require valid AWS credentials).
# ============================================================================

# ----------------------------------------------------------------------------
# AWS Credentials
# Local dev only. On ECS Fargate / AgentCore Runtime these are provided by the
# task/execution IAM role and MUST be left blank in the environment.
# ----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: only needed when using temporary STS credentials
AWS_SESSION_TOKEN=
# Region for all AWS SDK / Bedrock calls (all services)
AWS_REGION=us-east-1

# ----------------------------------------------------------------------------
# AWS Bedrock (the Software 3.0 "CPU" — model inference)
# ----------------------------------------------------------------------------
# Primary model for documentation, architecture, and transformation planning
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Bedrock call budget. botocore defaults the read timeout to 60s, but a
# 4096-token documentation generation against a real analysis context measures
# ~75s — on the default, a working call fails as a read timeout.
BEDROCK_READ_TIMEOUT_SECONDS=300
BEDROCK_CONNECT_TIMEOUT_SECONDS=10
# Retry budget for Bedrock calls: 2 attempts total (one retry), exponential
# backoff on retryable failures (timeout, throttling, transient service
# errors). A denied model, an invalid request or an expired credential fails on
# the first attempt. Worst case before a "failed" verdict is
# BEDROCK_MAX_ATTEMPTS × BEDROCK_READ_TIMEOUT_SECONDS plus backoff (~10 min at
# these values), so raise the two together, not one in isolation.
BEDROCK_MAX_ATTEMPTS=2
BEDROCK_RETRY_BASE_DELAY_SECONDS=1.0
# Set true to deliberately skip Phase 2 AI enrichment. Analysis still completes
# and every deterministic result persists; enrichment reports "skipped".
SKIP_AI_ENRICHMENT=false
# Optional Knowledge Base for RAG (Design Doc agent, Stage 1 context)
BEDROCK_KB_ID=
# Optional Guardrails for content filtering + PII detection
BEDROCK_GUARDRAIL_ID=

# ----------------------------------------------------------------------------
# Authentication
# Mode is auto-detected from which variables are set (see backend/config.py):
#   AUTH_DISABLED=true                         -> disabled (dev)
#   COGNITO_USER_POOL_ID + COGNITO_CLIENT_ID   -> Cognito RS256 (production)
#   LOCAL_AUTH_SECRET                          -> local JWT HS256 (staging)
# Precedence: disabled > cognito > local > disabled fallback.
# ----------------------------------------------------------------------------
# Mode 1 - Disabled (dev): true bypasses all token validation
AUTH_DISABLED=true

# Mode 2 - Local JWT (staging): HS256 signing key for /api/auth/login
# Generate one with: openssl rand -hex 32
LOCAL_AUTH_SECRET=

# Mode 3 - Cognito (production): RS256 JWKS validation
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ----------------------------------------------------------------------------
# GitHub (private repo clone + PR creation)
# Personal Access Token (classic or fine-grained) with repo scope.
# In AgentCore mode this env var is replaced by the AgentCore Identity OAuth
# credential store (see Requirement 19) and MUST be left blank.
# ----------------------------------------------------------------------------
GITHUB_TOKEN=

# ----------------------------------------------------------------------------
# AgentCore Mode
# Switches **only** token encryption: AWS Secrets Manager when true, base64
# when false. Read in exactly one place, backend/utils/encryption.py.
#
# It does NOT move progress to DynamoDB or analysis results to S3 — no S3 or
# DynamoDB client exists in the backend. A required build keeps all state local:
# in-memory progress (utils/progress_tracker.py) and JSON files under /app/temp
# (utils/storage_manager.py). The externalised-state design belongs to the
# AgentCore migration (.kiro/specs/code-insights-platform/tasks-agentcore.md).
# ----------------------------------------------------------------------------
AGENTCORE_MODE=false
# Declared but unused: nothing in the backend reads either of these. They are
# part of the AgentCore migration, not of this build.
PROGRESS_TABLE=CodeInsights-Progress
ANALYSIS_BUCKET=code-insights-analyses

# ----------------------------------------------------------------------------
# Analysis
# ----------------------------------------------------------------------------
# Gates the OSV vulnerability scan during the deterministic analysis phase, so
# upgrade recommendations can cite real advisories. Set false for air-gapped
# environments; recommendations then come from the curated rules only.
VULN_SCAN_ENABLED=true

# ----------------------------------------------------------------------------
# MCP (Model Context Protocol)
# The backend exposes an stdio MCP server (11 tools) for external AI agents and
# runs an in-process static-analysis MCP server (9 tools) for Strands agents.
# ----------------------------------------------------------------------------
# Log verbosity for the stdio MCP server (DEBUG|INFO|WARNING|ERROR)
MCP_LOG_LEVEL=ERROR
# Enable the external stdio MCP server exposing backend tools
MCP_SERVER_ENABLED=true

# ----------------------------------------------------------------------------
# Inter-Service URLs (Docker Compose service DNS names)
# The backend proxies spec generation to the Kiro CLI agent over backend-net.
# ----------------------------------------------------------------------------
KIRO_CLI_AGENT_URL=http://kiro-cli-agent:8007

# ----------------------------------------------------------------------------
# CORS (comma-separated list of allowed browser origins)
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------------------------------------------------------------------
# Rate Limiting (slowapi) — requests per minute per client IP
# ----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# ----------------------------------------------------------------------------
# Container Agent Portfolio (EKS delivery/design agents, ttyd on 7681-7684)
# Host directory bind-mounted into every EKS agent at /workspace so an
# operator's working files are shared with the web terminals. The shared
# repos volume (/app/repos) is a named docker volume and needs no config.
# ----------------------------------------------------------------------------
EKS_WORKSPACE_DIR=./container-agents-portfolio/workspace
